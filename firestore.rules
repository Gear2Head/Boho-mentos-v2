rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Yardımcı fonskiyonlar
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.superAdmin == true ||
        request.auth.token.email == 'senerkadiralper@gmail.com'
      );
    }

    function isValidImage() {
      return request.resource.data.url is string && request.resource.data.url.matches('https://firebasestorage.googleapis.com/.*');
    }

    match /users/{userId} {
      // Profil: Liderlik tablosu veya arama için sadece belirli alanlar dışarı açılmalı.
      // Şimdilik list yetkisini kısıtlayıp sadece get yetkisini bırakıyoruz (ID biliniyorsa).
      allow get: if isAuthenticated();
      allow list: if isAuthenticated(); // Leaderboard için gerekli
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) || isSuperAdmin();
      allow delete: if isSuperAdmin();
      
      // -- Alt Koleksiyonlar (Subcollections) --
      
      match /logs/{logId} {
        allow read, delete: if isOwner(userId) || isSuperAdmin();
        // Schema Validation
        allow create, update: if (isOwner(userId) || isSuperAdmin()) && 
                              request.resource.data.keys().hasAll(['id', 'date', 'subject', 'topic', 'questions', 'correct', 'wrong', 'empty', 'avgTime', 'fatigue']);
      }
      
      match /exams/{examId} {
        allow read, delete: if isOwner(userId) || isSuperAdmin();
        // Schema Validation
        allow create, update: if (isOwner(userId) || isSuperAdmin()) &&
                              request.resource.data.keys().hasAll(['id', 'date', 'type', 'totalNet', 'scores']); 
      }

      // Diğer veriler için standart sahiplik kontrolü
      match /chatHistory/{document=**} { allow read, write: if isOwner(userId) || isSuperAdmin(); }
      match /conversations/{document=**} { allow read, write: if isOwner(userId) || isSuperAdmin(); }
      match /agendaEntries/{document=**} { allow read, write: if isOwner(userId) || isSuperAdmin(); }
      match /focusSessions/{document=**} { allow read, write: if isOwner(userId) || isSuperAdmin(); }
      match /failedQuestions/{document=**} { allow read, write: if isOwner(userId) || isSuperAdmin(); }
      match /directiveHistory/{document=**} { allow read, write: if isOwner(userId) || isSuperAdmin(); }
      match /flashcards/{document=**} { allow read, write: if isOwner(userId) || isSuperAdmin(); }
    }
    
    // Sistem config: Anonim erişim kapatıldı.
    match /system_config/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
    
    match /failed_questions/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow write: if isOwner(userId) && isValidImage();
    }
    
    // Admin logları (audit)
    match /admin_logs/{document=**} {
      allow read, write: if isSuperAdmin();
    }
    
    // DM Chat Odaları
    match /global_chats/{chatRoomId} {
      allow read, write: if isAuthenticated() && chatRoomId.matches('.*' + request.auth.uid + '.*');
      match /messages/{messageId} {
        allow read, write: if isAuthenticated() && chatRoomId.matches('.*' + request.auth.uid + '.*');
      }
    }
  }
}

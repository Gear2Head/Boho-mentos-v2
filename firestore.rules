rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Yardımcı fonskiyonlar
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.superAdmin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    match /users/{userId} {
      // Profil: Liderlik tablosu için herkes (giriş yapmış) okuyabilir.
      allow get: if isAuthenticated();
      allow list: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) || isSuperAdmin();
      allow delete: if isSuperAdmin();
      
      // -- Alt Koleksiyonlar (Subcollections) --
      
      match /logs/{logId} {
        allow read, delete: if isOwner(userId) || isSuperAdmin();
        // Schema Validation
        allow create, update: if (isOwner(userId) || isSuperAdmin()) && 
                              request.resource.data.keys().hasAll(['id', 'date', 'subject', 'topic', 'questions', 'correct', 'wrong', 'empty', 'avgTime', 'fatigue', 'stress', 'motivation']);
      }
      
      match /exams/{examId} {
        allow read, delete: if isOwner(userId) || isSuperAdmin();
        // Schema Validation
        allow create, update: if (isOwner(userId) || isSuperAdmin()) &&
                              request.resource.data.keys().hasAll(['id', 'date', 'title', 'type', 'net', 'duration']); 
      }

      // Diğer veriler için standart sahiplik kontrolü
      match /chatHistory/{document=**} { allow read, write: if isOwner(userId) || isSuperAdmin(); }
      match /conversations/{document=**} { allow read, write: if isOwner(userId) || isSuperAdmin(); }
      match /agendaEntries/{document=**} { allow read, write: if isOwner(userId) || isSuperAdmin(); }
      match /focusSessions/{document=**} { allow read, write: if isOwner(userId) || isSuperAdmin(); }
      match /failedQuestions/{document=**} { allow read, write: if isOwner(userId) || isSuperAdmin(); }
      match /directiveHistory/{document=**} { allow read, write: if isOwner(userId) || isSuperAdmin(); }
      match /flashcards/{document=**} { allow read, write: if isOwner(userId) || isSuperAdmin(); }
    }
    
    // Sistem config dışa açık, admin yetkili
    match /system_config/{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    
    // Admin logları (audit)
    match /admin_logs/{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
